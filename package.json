{
  "name": "@locochat/core",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "workspaces": [
    "clients/*"
  ],
  "scripts": {
    "watch:core": "tsc --watch",
    "watch:electron": "npm run watch -w @locochat/electron",
    "dev:electron": "npm run dev -w @locochat/electron",
    "dev:desktop": "concurrently \"npm:watch:core\" \"npm:watch:electron\" \"npm:dev:electron\"",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/unit/**/**/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/**/**/*.test.ts",
    "test:smoke": "tsx --test tests/smoke/**/**/**/*.test.ts",
    "test:all": "tsx --test tests/unit/**/**/**/*.test.ts tests/integration/**/**/**/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rohit-MK2k/CodeX.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Rohit-MK2k/CodeX/issues"
  },
  "homepage": "https://github.com/Rohit-MK2k/CodeX#readme",
  "description": "",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@google/genai": "^2.12.0",
    "dotenv": "^17.4.2",
    "openai": "^6.48.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
