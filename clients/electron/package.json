{
  "name": "@locochat/electron",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nodemon --watch ../../dist --watch ./dist --exec electron .",
    "build": "tsc",
    "watch": "tsc --watch",
    "package": "electron-builder"
  },
  "build": {
    "appId": "com.locochat.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "../../dist/**/*",
      "../ui/dist/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@locochat/core": "file:../.."
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14"
  }
}
